# ---------------------------------------------------------------------------
# Molt — environment template. Copy to `.env` and fill in.
# NEVER commit `.env`. It is gitignored.
# ---------------------------------------------------------------------------

# Bright Data API key. Get it from https://brightdata.com/cp/setting/users
# `bdata login` stores a key for the CLI; Molt's REST telemetry reads this one.
BRIGHTDATA_API_KEY=

# ---------------------------------------------------------------------------
# Collector IDs — the production endpoints Molt watches.
# Populated by `pnpm molt:bootstrap` (or copy from `bdata scraper create`).
# ---------------------------------------------------------------------------

# The real long-tail target.
MOLT_COLLECTOR_PRIMARY=

# The chaos target — our own breakable page, for deterministic heal demos.
MOLT_COLLECTOR_CHAOS=

# ---------------------------------------------------------------------------
# Molt runtime
# ---------------------------------------------------------------------------

# SQLite location. Default keeps the repo clone-and-run with zero setup.
# For a serverless deploy (Vercel etc.) the filesystem is ephemeral, so point
# this at a hosted libSQL database instead, e.g. libsql://molt-xxxx.turso.io.
MOLT_DATABASE_URL=file:./data/molt.db

# Auth token for a libsql:// MOLT_DATABASE_URL (e.g. from `turso db tokens create`).
# Unused for file:/:memory: URLs.
MOLT_DATABASE_AUTH_TOKEN=

# Base URL of the chaos site (apps/chaos), used as the chaos collector target.
MOLT_CHAOS_BASE_URL=https://molt-chaos.vercel.app


# ---------------------------------------------------------------------------
# Web playground
# ---------------------------------------------------------------------------

# Enables the /playground page's "Live check" tab, which runs a real
# `bdata scraper run` against the chaos collector and therefore spends credits.
# Off unless set to exactly "1": the other two playground tabs (target preflight
# and drift replay) need neither an account nor credits and are always available.
MOLT_PLAYGROUND_LIVE=

# Enables the /playground page's "Create a collector" tab, which runs the same
# pipeline as `molt add` — preflight, then a real `bdata scraper create`, then a
# baseline check — for any URL and description a visitor types in. Off unless
# set to exactly "1". A separate flag from MOLT_PLAYGROUND_LIVE on purpose: this
# one spends far more (an AI-Flow create, not a run) and carries a risk the live
# tab does not — a failed generation leaves an orphaned collector on the
# connected Bright Data account that cannot be deleted programmatically (see
# CLAUDE.md's verified constraints). Turning this on is a real decision about
# that account's exposure to anyone who finds the URL, not a toggle to flip
# without thinking. It is layered under a one-per-hour rate limit and the same
# preflight blockers `molt add` enforces, with no --force equivalent.
MOLT_PLAYGROUND_CREATE=

# Absolute origin used to resolve Open Graph and icon URLs. Optional — on Vercel
# VERCEL_PROJECT_PRODUCTION_URL is used automatically, and localhost otherwise.
MOLT_SITE_URL=
