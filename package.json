{
  "name": "molt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Scraper Reliability Engineering for Bright Data Scraper Studio — detect silent breakage, heal it, verify the fix.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/PrinceXDev/molt-scraperstudio.git"
  },
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "molt": "pnpm --silent --filter @molt/sentinel molt",
    "chaos:deploy": "node scripts/chaos-deploy.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@brightdata/cli": "^0.3.5",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.2"
  }
}
